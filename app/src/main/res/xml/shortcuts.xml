        android:shortcutDisabledMessage="@string/shortcut_scan_storage_desc">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.aistudio.galaxycleaner.a12c"
            android:targetClass="com.galaxya12.cleaner.MainActivity">
            <extra android:name="action" android:value="SCAN_STORAGE" />
        </intent>
        <categories android:name="android.shortcut.conversation" />
